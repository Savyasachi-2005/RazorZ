DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/razorz
AI_PROVIDER=mock
AI_MODEL=gemini-2.0-flash
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_TIMEOUT_SECONDS=20
ENVIRONMENT=development
DEBUG=true
# API authentication. Comma-separated keys; sent as X-API-Key or Authorization: Bearer.
# Empty disables auth in development; ENVIRONMENT=production refuses to serve without it.
RAZORZ_API_KEYS=
# Require a signed-in user (or API key) on protected routes even with no API keys set.
RAZORZ_AUTH_REQUIRED=false
# First admin, created at startup only if this account does not exist yet.
RAZORZ_ADMIN_EMAIL=
RAZORZ_ADMIN_PASSWORD=
RAZORZ_ADMIN_NAME=Administrator
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=http://localhost:5173

# Razorpay Test Mode (never commit real secrets)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=20
RAZORPAY_ALLOW_LIVE=false
# Webhook secret from Razorpay Dashboard → Settings → Webhooks (not the API key secret)
RAZORPAY_WEBHOOK_SECRET=
# Run a full polling reconciliation after each ingested webhook (off by default)
RAZORPAY_WEBHOOK_RECONCILE=false
